import { Palette, Fonts, Sizes, Space } from "design_tokens.slint";

export global Theme {

    out property <color> text_3: #8A93A6;

    out property <length> wallet_status_w: 90px;
    out property <float> strip_name_stretch: 2;
    out property <float> strip_address_stretch: 5;

    out property <length> window_w: 1180px;
    out property <length> window_h: 820px;
    out property <length> window_min_w: 900px;
    out property <length> window_min_h: 520px;
    out property <length> page_min_h: 640px;
    out property <length> topnav_h: 60px;
    out property <length> card_header_h: 60px;
    out property <length> activity_filter_h: 46px;
    out property <length> tx_row_line_h: 20px;
    out property <length> tx_row_pad_v: 5px;
    out property <length> field_h: 44px;
    out property <length> amount_h: 46px;
    out property <length> send_btn_h: 48px;
    out property <length> pw_field_h: 46px;
    out property <length> asset_list_max_h: 258px;
    out property <length> token_selector_w: 150px;
    out property <length> send_btn_w: 124px;
    out property <length> chat_input_h: 58px;
    out property <length> chat_send_col_w: 168px;
    out property <length> swap_form_min_w: root.token_selector_w
        + Sizes.max_chip_w
        + 14 * root.mono_char
        + 5 * Space.s_16;
    out property <length> menu_overhang: 4px;

    out property <length> activity_col_gap: Space.s_12;
    out property <length> activity_row_pad: Space.s_16;
    out property <length> mono_char: Fonts.small * 0.6;
    out property <length> mono_group: Fonts.small / 3;

    out property <length> activity_time_w: 8 * root.mono_char;
    out property <length> activity_type_w: 40px;
    out property <length> activity_amount_value_w: 22 * root.mono_char + 2 * root.mono_group;
    out property <length> activity_amount_token_gap_w: Space.s_8;
    out property <length> activity_amount_token_avatar_w: 18px;
    out property <length> activity_amount_token_symbol_w: 44px;
    out property <length> activity_amount_w: root.activity_amount_value_w
        + root.activity_amount_token_gap_w
        + root.activity_amount_token_avatar_w
        + root.activity_amount_token_symbol_w;
    out property <length> assets_panel_min_w: Sizes.control_large
        + 10 * root.mono_char
        + root.activity_amount_value_w
        + 4 * Space.s_12;
    out property <length> activity_fee_w: 12 * root.mono_char + 2 * root.mono_group;
    out property <length> activity_final_w: 52px + Space.s_6 + Sizes.icon_sm;
    out property <length> explorer_amount_w: 226px;
    out property <length> explorer_fee_w: 112px;
    out property <length> explorer_hash_w: 168px;
    out property <length> explorer_hash_gap: 14px;
    out property <length> account_label_w: 106px;
    out property <length> stat_label_w: 84px;
    out property <length> account_boc_w: 264px;
    out property <length> account_list_row_h: 26px;
    out property <int> account_list_max_rows: 3;
    out property <int> decoded_list_max_rows: 6;

}

export global Status {
    pure public function account_fg(status: string) -> color {
        return status == "Active" ? Palette.positive
            : status == "Uninit" ? Palette.warning
            : status == "Frozen" ? Palette.negative
            : Palette.text_tertiary;
    }
}

export global Anim {
    in-out property <angle> spin: 0deg;
}

export global PageScroll {
    in-out property <bool> held: false;
}
