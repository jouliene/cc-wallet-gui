export global Status {
    pure public function account_fg(status: string) -> color {
        return status == "Active" ? Palette.positive
            : status == "Uninit" ? Palette.warning
            : status == "Frozen" ? Palette.negative
            : Palette.text_tertiary;
    }
}

export global Anim {
    in-out property <angle> spin: 0deg;
}

export global PageScroll {
    in-out property <bool> held: false;
}
