import { Theme } from "../theme.slint";
import { Palette, Fonts, Elevation, Space, Radii } from "../design_tokens.slint";
import { Icon, MicroLabel, PrimaryButton, GhostButton, IconButton, DialogCard, DialogHeader, Field, UserActivity, InlineError } from "../widgets.slint";

export component WalletPicker inherits Rectangle {
    in property <[string]> wallets: [];
    in property <string> error: "";
    in property <bool> busy: false;
    callback select(string);
    callback create_new();
    callback delete(string, string);

    property <string> pending_delete: "";
    property <string> pw_text: "";
    property <bool> pw_visible: false;
    property <bool> attempted: false;
    property <length> list_cap: 6 * 46px + 5 * 8px;

    background: Palette.surface_base;
    TouchArea {}

    function submit_delete() {
        if (root.busy || root.pw_text == "" || root.pending_delete == "") {
            return;
        }
        root.attempted = true;
        root.delete(root.pending_delete, root.pw_text);
    }
    function close_confirm() {
        root.pending_delete = "";
        root.attempted = false;
        root.pw_visible = false;
        root.pw_text = "";
    }
    changed busy => {
        if (!root.busy && root.attempted && root.error == "") {
            root.close_confirm();
        }
    }

    DialogCard {
        width: 440px;
        height: card.preferred-height;

        card := VerticalLayout {
            padding: Space.s_24;
            spacing: 18px;

            DialogHeader {
                icon: @image-url("../../assets/icons/wallet.svg");
                title: "Choose a wallet";
                subtitle: "Open an existing wallet or create a new one.";
            }

            VerticalLayout {
                spacing: Space.s_8;
                MicroLabel { text: "WALLETS"; }
                Flickable {
                    height: min(list_col.preferred-height, root.list_cap);
                    flicked => { UserActivity.ping(); }
                    viewport-width: self.width;
                    viewport-height: list_col.preferred-height;
                    interactive: true;
                    list_col := VerticalLayout {
                        spacing: Space.s_8;
                        for name in root.wallets: Rectangle {
                            height: 46px;
                            border-radius: Radii.md;
                            background: Palette.surface_sunken;
                            border-width: 1px;
                            border-color: touch.has-hover ? Palette.selected_border : Palette.border_strong;
                            touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select(name); }
                            }
                            HorizontalLayout {
                                padding-left: Space.s_14;
                                padding-right: Space.s_8;
                                spacing: Space.s_10;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: @image-url("../../assets/icons/wallet.svg");
                                        tint: Palette.text_secondary;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: name;
                                        color: Palette.text_primary;
                                        font-family: Fonts.ui;
                                        font-weight: Fonts.semibold;
                                        font-size: Fonts.body;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        size: 28px;
                                        icon_size: 16px;
                                        icon: @image-url("../../assets/icons/trash.svg");
                                        tint: Palette.text_quiet;
                                        clicked => {
                                            root.pending_delete = name;
                                            root.attempted = false;
                                            root.pw_visible = false;
                                            root.pw_text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            PrimaryButton {
                label: "＋  Create new wallet";
                height: 44px;
                clicked => { root.create_new(); }
            }

        }
    }

    if root.pending_delete != "": Rectangle {
        width: 100%;
        height: 100%;
        background: Elevation.scrim;
        TouchArea { clicked => { if (!root.busy) { root.close_confirm(); } } }
        DialogCard {
            width: 384px;
            height: confirm_card.preferred-height;
            TouchArea {}
            confirm_card := VerticalLayout {
                padding: Space.s_24;
                spacing: Space.s_16;
                DialogHeader {
                    icon: @image-url("../../assets/icons/trash.svg");
                    badge_bg: Palette.negative_quiet;
                    badge_tint: Palette.negative;
                    title: "Delete wallet?";
                    subtitle: root.pending_delete;
                }
                Text {
                    text: "This permanently deletes the wallet file. You can only restore it from its 12-word recovery phrase. Enter this wallet's password to confirm.";
                    color: Palette.text_tertiary;
                    font-family: Fonts.ui;
                    font-size: Fonts.small;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: Space.s_8;
                    MicroLabel { text: "PASSWORD"; }
                    Rectangle {
                        height: Theme.pw_field_h;
                        Field {
                            text <=> root.pw_text;
                            height_: Theme.pw_field_h;
                            input_type: root.pw_visible ? InputType.text : InputType.password;
                            is_secret: true;
                            placeholder: "••••••••";
                            pad_right: 38px;
                            accepted => { root.submit_delete(); }
                        }
                        IconButton {
                            x: parent.width - self.width - 6px;
                            y: (parent.height - self.height) / 2;
                            size: 26px;
                            icon_size: 16px;
                            icon: root.pw_visible ? @image-url("../../assets/icons/eye-off.svg") : @image-url("../../assets/icons/eye.svg");
                            tint: Palette.text_tertiary;
                            clicked => { root.pw_visible = !root.pw_visible; }
                        }
                    }
                    if root.attempted && root.error != "": InlineError { text: root.error; }
                }
                HorizontalLayout {
                    spacing: Space.s_10;
                    GhostButton {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        label: "Cancel";
                        enabled: !root.busy;
                        clicked => { root.close_confirm(); }
                    }
                    PrimaryButton {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        bg: Palette.negative_fill;
                        enabled: root.pw_text != "" && !root.busy;
                        label: "Delete";
                        clicked => { root.submit_delete(); }
                    }
                }
            }
        }
    }
}
