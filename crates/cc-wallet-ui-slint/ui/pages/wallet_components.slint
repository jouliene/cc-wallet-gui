import { Theme, Anim } from "../theme.slint";
import { Palette, Fonts, Fade, Motion, Radii, Sizes, Space } from "../design_tokens.slint";
import { Icon, Avatar, Chip, CopyButton, IconButton, Amount } from "../widgets.slint";
import { AssetRow, ActivityRow, TokenAmount } from "../models.slint";

export component AssetListRow inherits Rectangle {
    in property <AssetRow> asset;
    callback clicked();
    height: 54px;
    border-radius: Radii.md;
    border-width: 1px;
    border-color: root.asset.selected ? Palette.selected_border : Palette.border_strong;
    background: root.asset.selected
        ? (ta.has-hover ? Palette.selected_fill_hover : Palette.selected_fill)
        : (root.asset.sendable && ta.has-hover ? Palette.hover_row : Palette.surface_inset);
    animate background { duration: Motion.fast; easing: Motion.curve; }
    ta := TouchArea {
        enabled: root.asset.sendable;
        mouse-cursor: root.asset.sendable ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Space.s_12;
        padding-right: Space.s_12;
        spacing: Space.s_12;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Avatar { initial: root.asset.initial; tint: root.asset.color; size: 32px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: Space.s_2;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.asset.name;
                color: root.asset.sendable ? Palette.text_primary : Palette.text_quiet;
                font-family: Fonts.ui;
                font-weight: Fonts.semibold;
                font-size: Fonts.body;
                overflow: elide;
            }
            Text {
                text: root.asset.symbol;
                color: Palette.text_tertiary;
                font-family: Fonts.ui;
                font-weight: Fonts.semibold;
                font-size: Fonts.small;
                letter-spacing: Fonts.tracking_caps;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Amount {
                alignment: end;
                amount: {
                    amount_int: root.asset.amount_int,
                    amount_frac: root.asset.amount_frac,
                };
                tint: Palette.text_primary;
                font_size: Fonts.balance;
                show_token: false;
                elide_fraction: true;
            }
        }
    }
}

component ActivityAmountValue inherits Rectangle {
    in property <TokenAmount> movement;
    in property <string> sign;
    in property <color> amount_color: Palette.value_neutral;
    in property <length> amount_font_size: Fonts.small;
    preferred-width: amount_value_line.preferred-width;
    height: 20px;
    clip: true;
    amount_value_line := Amount {
        alignment: end;
        amount: root.movement;
        sign: root.sign;
        tint: root.amount_color;
        font_size: root.amount_font_size;
        show_token: false;
    }
}

export component ActivityMovementAmount inherits Rectangle {
    in property <TokenAmount> movement;
    in property <string> sign;
    in property <color> amount_color: Palette.value_neutral;
    in property <color> symbol_color: Palette.text_tertiary;
    in property <length> amount_font_size: Fonts.small;
    in property <length> col_w: Theme.activity_amount_w;
    width: root.col_w;
    height: 20px;
    clip: true;
    HorizontalLayout {
        width: root.width;
        height: root.height;
        alignment: start;
        spacing: Space.s_0;
        amount_value_column := Rectangle {
            width: root.col_w - (Theme.activity_amount_token_gap_w + Theme.activity_amount_token_avatar_w + Theme.activity_amount_token_symbol_w);
            height: root.height;
            clip: true;
            ActivityAmountValue {
                width: parent.width;
                height: parent.height;
                movement: root.movement;
                sign: root.sign;
                amount_color: root.amount_color;
                amount_font_size: root.amount_font_size;
            }
        }
        Rectangle { width: Theme.activity_amount_token_gap_w; }
        VerticalLayout {
            width: Theme.activity_amount_token_avatar_w;
            alignment: center;
            Avatar { initial: root.movement.initial; tint: root.movement.color; size: Theme.activity_amount_token_avatar_w; }
        }
        token_symbol_column := Rectangle {
            width: Theme.activity_amount_token_symbol_w;
            HorizontalLayout {
                width: token_symbol_column.width;
                height: token_symbol_column.height;
                padding-left: Space.s_6;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.movement.symbol;
                        color: root.symbol_color;
                        font-family: Fonts.ui;
                        font-weight: Fonts.semibold;
                        font-size: Fonts.micro;
                    }
                }
            }
        }
    }
}

export component ActivityListRow inherits Rectangle {
    in property <ActivityRow> item;
    callback open_in_explorer();
    height: max(root.item.movements.length, 1) * Theme.tx_row_line_h + Theme.tx_row_pad_v * 2;
    Rectangle { y: 0; height: 1px; background: Palette.border_hairline; }
    VerticalLayout {
        Rectangle {
            height: root.height;
            HorizontalLayout {
                padding-left: Theme.activity_row_pad;
                padding-right: Theme.activity_row_pad;
                spacing: Space.s_0;
                Text { width: Theme.activity_time_w; text: root.item.time; color: Palette.text_tertiary; font-family: Fonts.mono; font-size: Fonts.small; vertical-alignment: center; }
                Rectangle {
                    width: Theme.activity_type_w;
                    HorizontalLayout {
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Chip {
                                label: root.item.kind;
                                min_w: 34px;
                                fg: !root.item.success ? Palette.negative : (root.item.is_in ? Palette.value_in : Palette.value_out);
                                bg: !root.item.success ? Palette.negative_quiet : (root.item.is_in ? Palette.positive_quiet : Palette.badge_neutral);
                                frame: !root.item.success ? Palette.negative_border : (root.item.is_in ? Palette.positive_border : Palette.border_subtle);
                                font_size: Fonts.micro;
                                weight: 700;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Space.s_4;
                    padding-right: Space.s_4;
                    if root.item.party_name != "": Text {
                        text: root.item.party_name;
                        color: Palette.text_secondary;
                        font-family: Fonts.ui;
                        font-weight: Fonts.semibold;
                        font-size: Fonts.small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.item.party_name == "": Text {
                        text: root.item.party_full;
                        color: Palette.text_tertiary;
                        font-family: Fonts.mono;
                        font-size: Fonts.micro;
                        vertical-alignment: center;
                        min-width: 0px;
                    }
                    if root.item.has_party: VerticalLayout {
                        alignment: center;
                        CopyButton { value: root.item.party_full; }
                    }
                    if root.item.has_party: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../../assets/icons/external-link.svg");
                            tint: Palette.text_quiet;
                            size: Sizes.control_dense;
                            icon_size: Sizes.icon_sm;
                            clicked => { root.open_in_explorer(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; min-width: 0px; }
                }
                Rectangle {
                    width: Theme.activity_amount_w;
                    clip: true;
                    VerticalLayout {
                        alignment: center;
                        spacing: Space.s_0;
                        for m in root.item.movements: ActivityMovementAmount {
                            movement: m;
                            sign: root.item.is_in ? "+" : "−";
                            amount_color: !root.item.success ? Palette.negative : (root.item.is_in ? Palette.value_in : Palette.value_out);
                        }
                    }
                }
                Rectangle { width: Theme.activity_money_gap; }
                Rectangle {
                    width: Theme.activity_fee_w;
                    clip: true;
                    Amount {
                        width: parent.width;
                        alignment: start;
                        amount: root.item.fee;
                        tint: Palette.value_neutral;
                        int_weight: Fonts.semibold;
                        font_size: Fonts.small;
                        show_token: false;
                    }
                }
                Rectangle { width: Theme.activity_fee_gap; }
                Rectangle {
                    width: Theme.activity_final_w;
                    HorizontalLayout {
                        alignment: end;
                        spacing: Space.s_6;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.item.pending ? "sending…" : (!root.item.success ? "failed" : (root.item.finality == "" ? "—" : root.item.finality));
                                color: root.item.pending ? Palette.warning : (!root.item.success ? Palette.negative : (root.item.finality == "" ? Palette.text_quiet : Palette.text_secondary));
                                font-family: Fonts.ui;
                                font-size: Fonts.micro;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            if root.item.pending: Rectangle {
                                width: Sizes.icon_sm; height: Sizes.icon_sm;
                                for i in 8: Rectangle {
                                    property <angle> a: i * 45deg;
                                    width: 2.6px; height: 2.6px;
                                    border-radius: self.height / 2;
                                    background: Palette.warning;
                                    x: 7px + 4.6px * Math.cos(self.a) - self.width / 2;
                                    y: 7px + 4.6px * Math.sin(self.a) - self.height / 2;
                                    opacity: 1.0 - (Math.mod((Anim.spin - self.a) / 1deg, 360) / 360) * 0.82;
                                }
                            }
                            if !root.item.pending: Icon {
                                source: root.item.success ? @image-url("../../assets/icons/check.svg") : @image-url("../../assets/icons/x.svg");
                                tint: root.item.success ? Palette.positive : Palette.negative;
                                width: Sizes.icon_sm; height: Sizes.icon_sm;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SegBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 24px;
    width: seg_t.preferred-width + 22px;
    border-radius: 7px;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Palette.focus_ring;
    fs := FocusScope {
        enabled: true;
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    background: root.active ? Palette.accent_quiet : (seg_ta.has-hover ? Palette.hover_row : transparent);
    seg_t := Text {
        text: root.label;
        color: root.active ? Palette.accent_text : Palette.text_tertiary;
        font-family: Fonts.ui;
        font-weight: Fonts.semibold;
        font-size: Fonts.small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    seg_ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
