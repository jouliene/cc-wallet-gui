import { Theme } from "../theme.slint";
import { Palette, Fonts, Radii, Space, Motion, Sizes } from "../design_tokens.slint";
import { Icon, Card, CardHeader, MicroLabel, FieldLabel, PrimaryButton, GhostButton, IconButton, CopyButton, SecretCopyButton, Field, EmptyState, InlineError, Amount, UserActivity, ClipboardBridge } from "../widgets.slint";
import { StorageRow, TokenAmount } from "../models.slint";

component RecordRow inherits Rectangle {
    in property <StorageRow> record;
    in property <bool> busy;
    in property <bool> revealed;
    in property <length> number_w;
    in property <length> title_w;
    in property <length> col_gap;
    callback delete_record(int);
    callback copy_record(int);

    // A record may be several lines long, and a record you cannot read in full
    // is not much use — so the row grows to fit one, while a single-line record
    // keeps the compact height that lets more of them fit on screen.
    height: max(44px, body.preferred-height);
    background: ta.has-hover ? Palette.hover_row : transparent;
    animate background { duration: Motion.base; easing: Motion.curve; }

    ta := TouchArea { }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border_subtle;
    }

    body := HorizontalLayout {
        padding-left: Space.s_16;
        padding-right: Space.s_8;
        padding-top: Space.s_12;
        padding-bottom: Space.s_12;
        spacing: root.col_gap;

        VerticalLayout {
            alignment: start;
            width: root.number_w;
            Text {
                text: root.record.id;
                color: Palette.text_quiet;
                font-family: Fonts.mono;
                font-size: Fonts.small;
            }
        }

        VerticalLayout {
            alignment: start;
            width: root.title_w;
            Text {
                text: root.record.title;
                color: Palette.text_primary;
                font-family: Fonts.ui;
                font-weight: Fonts.semibold;
                font-size: Fonts.body;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: start;
            horizontal-stretch: 1;
            if root.revealed: Text {
                text: root.record.data;
                color: Palette.text_secondary;
                font-family: Fonts.mono;
                font-size: Fonts.small;
                wrap: word-wrap;
            }
            if !root.revealed: Text {
                text: "••••••••••••";
                color: Palette.text_quiet;
                font-family: Fonts.mono;
                font-size: Fonts.small;
            }
        }

        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: Space.s_4;
                alignment: end;
                SecretCopyButton {
                    copy => { root.copy_record(root.record.id); }
                }
                IconButton {
                    icon: @image-url("../../assets/icons/trash.svg");
                    tint: Palette.negative;
                    size: Sizes.control_dense;
                    icon_size: Sizes.icon_sm;
                    enabled: !root.busy;
                    clicked => { root.delete_record(root.record.id); }
                }
            }
        }
    }
}

export component StoragePage inherits VerticalLayout {
    in property <length> page_height: 400px;
    in property <bool> has_wallet;
    in property <string> address;
    in property <bool> exists;
    in property <bool> loading;
    in property <bool> busy;
    in property <string> pending_label;
    in property <string> error;
    in property <string> notice;
    in property <TokenAmount> balance;
    in property <int> count;
    in property <int> limit;
    in property <int> unreadable;
    in property <bool> revealed;
    in property <[StorageRow]> records;
    in property <bool> add_enabled;
    in property <string> form_error;
    in property <int> title_limit;
    in property <int> data_limit;
    in property <int> title_bytes;
    in property <int> data_bytes;
    in-out property <string> title_input;
    in-out property <string> data_input;

    callback create_storage();
    callback refresh_storage();
    callback add_record();
    callback clear_form();
    callback reveal_records();
    callback hide_records();
    callback delete_record(int);
    callback copy_record(int);
    callback title_edited(string);
    callback data_edited(string);
    callback open_in_explorer(string, string);

    height: root.page_height;
    padding-top: Space.s_4;
    spacing: Space.s_16;

    // The heading row and the record rows read these same three, so a column
    // and its label can never end up starting in different places.
    property <length> col_number_w: 44px;
    property <length> col_title_w: 210px;
    property <length> col_gap: Space.s_12;

    Card {
        vertical-stretch: 1;
        VerticalLayout {
            CardHeader {
                icon: @image-url("../../assets/icons/vault.svg");
                title: "Storage";
                subtitle: root.exists
                    ? (root.count + " of " + root.limit + " records, encrypted with this wallet's key")
                    : "A private, encrypted store on chain that only this wallet can read";
                HorizontalLayout {
                    spacing: Space.s_8;
                    alignment: end;
                    if root.exists && root.count > 0: VerticalLayout {
                        alignment: center;
                        GhostButton {
                            label: root.revealed ? "Hide" : "Reveal";
                            clicked => {
                                UserActivity.ping();
                                if (root.revealed) { root.hide_records(); } else { root.reveal_records(); }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../../assets/icons/refresh.svg");
                            enabled: !root.loading && root.has_wallet;
                            clicked => { root.refresh_storage(); }
                        }
                    }
                }
            }

            if root.exists: HorizontalLayout {
                padding-left: Space.s_12;
                padding-right: Space.s_12;
                padding-top: Space.s_10;
                padding-bottom: Space.s_10;
                Rectangle {
                    background: Palette.surface_inset;
                    border-radius: Radii.md;
                    border-width: 1px;
                    border-color: Palette.border_subtle;
                    height: zone.preferred-height;
                    zone := VerticalLayout {
                        padding-left: Space.s_12;
                        padding-right: Space.s_10;
                        padding-top: Space.s_8;
                        padding-bottom: Space.s_8;
                        spacing: Space.s_2;

                        HorizontalLayout {
                            height: Theme.account_list_row_h;
                            spacing: Space.s_0;
                            VerticalLayout {
                                alignment: center;
                                width: Theme.account_label_w;
                                FieldLabel { text: "Address"; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.address;
                                    color: Palette.text_value;
                                    font-family: Fonts.mono;
                                    font-size: Fonts.small;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                padding-left: Space.s_6;
                                CopyButton { value: root.address; }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("../../assets/icons/external-link.svg");
                                    size: Sizes.control_dense;
                                    icon_size: Sizes.icon_sm;
                                    clicked => { root.open_in_explorer(root.address, ""); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; min-width: 0px; }
                        }

                        HorizontalLayout {
                            height: Theme.account_list_row_h;
                            spacing: Space.s_0;
                            VerticalLayout {
                                alignment: center;
                                width: Theme.account_label_w;
                                FieldLabel { text: "Balance"; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Amount { amount: root.balance; tint: Palette.value_in; }
                            }
                            Rectangle { horizontal-stretch: 1; min-width: 0px; }
                        }
                    }
                }
            }

            if !root.exists: VerticalLayout {
                vertical-stretch: 1;
                padding: Space.s_24;
                EmptyState {
                    icon: @image-url("../../assets/icons/vault.svg");
                    title: root.loading ? "Looking for your storage…" : "No storage yet";
                    subtitle: "Create one to keep notes, logins and numbers on chain. Every record is encrypted on this machine before it is sent — the chain only ever sees ciphertext.";
                    HorizontalLayout {
                        alignment: center;
                        padding-top: Space.s_8;
                        PrimaryButton {
                            label: root.busy ? "Creating…" : "Create storage";
                            enabled: root.has_wallet && !root.busy && !root.loading;
                            clicked => { UserActivity.ping(); root.create_storage(); }
                        }
                    }
                }
            }

            if root.exists: VerticalLayout {
                vertical-stretch: 1;

                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: Space.s_16;
                        padding-right: Space.s_8;
                        spacing: root.col_gap;
                        VerticalLayout {
                            alignment: center;
                            width: root.col_number_w;
                            MicroLabel { text: "#"; }
                        }
                        VerticalLayout {
                            alignment: center;
                            width: root.col_title_w;
                            MicroLabel { text: "NAME"; }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            MicroLabel { text: "RECORD"; }
                        }
                        VerticalLayout { alignment: center; width: 72px; }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Palette.border_subtle;
                    }
                }

                if root.count == 0: VerticalLayout {
                    vertical-stretch: 1;
                    padding: Space.s_24;
                    EmptyState {
                        icon: @image-url("../../assets/icons/seed.svg");
                        title: "No records yet";
                        subtitle: "Add the first one below.";
                    }
                }

                if root.count > 0: hold := Rectangle {
                    vertical-stretch: 1;
                    // Measured against the LIST's own height: taking it from the
                    // wrapper left the hint claiming there was more after the
                    // list had already reached its end.
                    property <bool> more_below:
                        list.viewport-height - list.height + list.viewport-y > 1px;
                    list := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: rows.preferred-height;
                    rows := VerticalLayout {
                        alignment: start;
                        for row in root.records: RecordRow {
                            record: row;
                            busy: root.busy;
                            revealed: root.revealed;
                            number_w: root.col_number_w;
                            title_w: root.col_title_w;
                            col_gap: root.col_gap;
                            delete_record(id) => { UserActivity.ping(); root.delete_record(id); }
                            copy_record(id) => { root.copy_record(id); }
                        }
                    }
                    }

                    // Anything below the fold is invisible otherwise, so the
                    // list says so: the rows fade out under a count of what is
                    // still down there, and both go away at the bottom.
                    if hold.more_below: Rectangle {
                        y: parent.height - self.height;
                        height: 44px;
                        background: @linear-gradient(180deg,
                            Palette.surface_raised_a0 0%,
                            Palette.surface_raised 78%);
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: end;
                                padding-bottom: Space.s_6;
                                Rectangle {
                                    background: Palette.surface_overlay;
                                    border-radius: Radii.sm;
                                    border-width: 1px;
                                    border-color: Palette.border_subtle;
                                    height: 20px;
                                    HorizontalLayout {
                                        padding-left: Space.s_8;
                                        padding-right: Space.s_8;
                                        spacing: Space.s_4;
                                        VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                source: @image-url("../../assets/icons/chevron-down.svg");
                                                tint: Palette.text_quiet;
                                                width: 11px;
                                                height: 11px;
                                            }
                                        }
                                        Text {
                                            text: "More below";
                                            color: Palette.text_quiet;
                                            font-family: Fonts.ui;
                                            font-weight: Fonts.bold;
                                            font-size: Fonts.micro;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 26px;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Palette.border_subtle;
                }
                HorizontalLayout {
                    padding-left: Space.s_16;
                    padding-right: Space.s_16;
                    VerticalLayout {
                        alignment: center;
                        if root.error != "": InlineError { text: root.error; }
                        if root.error == "" && root.notice != "": Text {
                            text: root.notice;
                            color: Palette.text_quiet;
                            font-family: Fonts.ui;
                            font-size: Fonts.small;
                        }
                        if root.error == "" && root.notice == "" && root.unreadable > 0: Text {
                            text: root.unreadable + " record(s) here were written by a different wallet and cannot be read.";
                            color: Palette.negative;
                            font-family: Fonts.ui;
                            font-size: Fonts.small;
                        }
                    }
                }
            }
        }
    }

    if root.exists: Card {
        vertical-stretch: 0;
        VerticalLayout {
            alignment: start;
            CardHeader {
                icon: @image-url("../../assets/icons/plus.svg");
                title: "Add a record";
                subtitle: "The name and the record are encrypted together before they leave this machine";
                hairline: true;
            }
            VerticalLayout {
                padding-left: Space.s_16;
                padding-right: Space.s_16;
                padding-top: Space.s_10;
                padding-bottom: Space.s_10;
                spacing: Space.s_6;

                HorizontalLayout {
                    spacing: Space.s_12;
                    height: 96px;
                    VerticalLayout {
                        width: 300px;
                        alignment: start;
                        spacing: Space.s_4;
                        HorizontalLayout {
                            MicroLabel { text: "NAME"; }
                            Rectangle { }
                            Text {
                                text: root.title_bytes + "/" + root.title_limit;
                                color: root.title_bytes > root.title_limit ? Palette.negative : Palette.text_quiet;
                                font-family: Fonts.mono;
                                font-size: Fonts.micro;
                            }
                        }
                        title_field := Field {
                            text <=> root.title_input;
                            placeholder: "Name this record";
                            edited(t) => { root.title_edited(t); }
                            accepted => { if (root.add_enabled) { root.add_record(); } }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: Space.s_4;
                        HorizontalLayout {
                            MicroLabel { text: "RECORD"; }
                            Rectangle { }
                            Text {
                                text: root.data_bytes + "/" + root.data_limit;
                                color: root.data_bytes > root.data_limit ? Palette.negative : Palette.text_quiet;
                                font-family: Fonts.mono;
                                font-size: Fonts.micro;
                            }
                        }
                        Field {
                            text <=> root.data_input;
                            placeholder: "Anything you want kept private — a password, a number, a note";
                            font_family: Fonts.mono;
                            multiline: true;
                            height_: 70px;
                            edited(t) => { root.data_edited(t); }
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        spacing: Space.s_8;
                        width: 132px;
                        Rectangle { height: 18px; }
                        PrimaryButton {
                            label: root.busy ? root.pending_label : "Add record";
                            enabled: root.add_enabled;
                            clicked => { UserActivity.ping(); root.add_record(); }
                        }
                        GhostButton {
                            label: "Clear";
                            enabled: !root.busy && (root.title_input != "" || root.data_input != "");
                            clicked => { root.clear_form(); }
                        }
                    }
                }

                Rectangle {
                    height: 16px;
                    if root.form_error != "": InlineError { text: root.form_error; }
                }
            }
        }
    }
}
