import { Theme } from "../theme.slint";
import { Palette, Fonts, Radii, Space } from "../design_tokens.slint";
import { Icon, Avatar, IconButton, Chip, Field, MenuSurface, MicroLabel, UserActivity } from "../widgets.slint";
import { AssetRow, ContactRow } from "../models.slint";
import { ScrollView } from "std-widgets.slint";

export component WalletSwitcherMenu inherits MenuSurface {
    in property <[string]> wallet_names;
    in property <string> active_wallet;
    callback pick(string);
    callback choose();
    VerticalLayout {
        padding: Space.s_8;
        spacing: Space.s_2;
        Flickable {
            height: min(wlist.preferred-height, 6 * 38px + 5 * 2px);
            flicked => { UserActivity.ping(); }
            viewport-width: self.width;
            viewport-height: wlist.preferred-height;
            interactive: true;
            wlist := VerticalLayout {
                spacing: Space.s_2;
                for n in root.wallet_names: Rectangle {
                    height: 38px;
                    border-radius: Radii.sm;
                    border-width: 1px;
                    border-color: n == root.active_wallet ? Palette.selected_border : transparent;
                    background: n == root.active_wallet ? Palette.accent_quiet : (wrow.has-hover ? Palette.hover_strong : transparent);
                    HorizontalLayout {
                        padding-left: Space.s_10; padding-right: Space.s_10; spacing: Space.s_8;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: n;
                                color: Palette.text_primary;
                                font-family: Fonts.ui;
                                font-weight: Fonts.semibold;
                                font-size: Fonts.body;
                                overflow: elide;
                            }
                        }
                        if n == root.active_wallet: VerticalLayout {
                            alignment: center;
                            Icon { source: @image-url("../../assets/icons/check.svg"); tint: Palette.accent_text; width: 14px; height: 14px; }
                        }
                    }
                    wrow := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(n); }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Palette.border_medium; }
        Rectangle {
            height: 38px;
            border-radius: Radii.sm;
            background: nrow.has-hover ? Palette.hover_strong : transparent;
            HorizontalLayout {
                padding-left: Space.s_10; padding-right: Space.s_10; spacing: Space.s_8;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("../../assets/icons/wallet.svg");
                        tint: Palette.accent_text;
                        width: 15px; height: 15px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Choose wallet";
                        color: Palette.accent_text;
                        font-family: Fonts.ui;
                        font-weight: Fonts.semibold;
                        font-size: Fonts.body;
                    }
                }
            }
            nrow := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.choose(); }
            }
        }
    }
}

export component TokenPickerMenu inherits MenuSurface {
    in property <[AssetRow]> assets;
    callback pick(int);
    VerticalLayout {
        padding: Space.s_8;
        spacing: Space.s_2;
        for a in root.assets: Rectangle {
            height: 38px;
            border-radius: Radii.sm;
            border-width: 1px;
            border-color: a.selected ? Palette.selected_border : transparent;
            background: a.selected ? Palette.accent_quiet : (tta.has-hover ? Palette.hover_strong : transparent);
            HorizontalLayout {
                padding-left: Space.s_8; padding-right: Space.s_10; spacing: Space.s_8;
                VerticalLayout { alignment: center; Avatar { initial: a.initial; tint: a.color; size: 22px; } }
                VerticalLayout { alignment: center; Text { text: a.symbol; color: Palette.text_primary; font-family: Fonts.ui; font-weight: Fonts.semibold; font-size: Fonts.body; overflow: elide; } }
                Rectangle { }
            }
            tta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(a.control_id); }
            }
        }
    }
}

export component ContactPickerMenu inherits MenuSurface {
    in property <[ContactRow]> address_book;
    in property <int> address_book_count;
    in-out property <string> filter;
    pure callback contact_matches_search(string, string, string, string) -> bool;
    pure callback matching_contact_count(string) -> int;
    callback pick(string);
    property <int> shown: root.filter == "" ? root.address_book_count : root.matching_contact_count(root.filter);
    VerticalLayout {
        padding: Space.s_10;
        spacing: Space.s_6;
        HorizontalLayout {
            padding-left: Space.s_6; padding-right: Space.s_6;
            MicroLabel { text: "CONTACTS"; }
            Rectangle { }
            Text { text: root.address_book_count == 1 ? "1 contact" : root.address_book_count + " contacts"; color: Palette.text_quiet; font-family: Fonts.ui; font-size: Fonts.micro; vertical-alignment: center; }
        }
        Field {
            height_: 32px;
            text <=> root.filter;
            placeholder: "Search contacts";
            font_size: Fonts.small;
            pad_left: 10px;
        }
        if root.address_book_count == 0: Text {
            text: "No contacts yet";
            color: Palette.text_quiet; font-family: Fonts.ui; font-size: Fonts.small;
            horizontal-alignment: center;
        }
        if root.address_book_count > 0 && root.shown == 0: Text {
            height: 46px;
            text: "No matching contacts";
            color: Palette.text_quiet; font-family: Fonts.ui; font-size: Fonts.small;
            horizontal-alignment: center; vertical-alignment: center;
        }
        if root.shown > 0: ScrollView {
            height: min(root.shown * 48px - 2px, 240px);
            scrolled => { UserActivity.ping(); }
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            viewport-height: max(0px, root.shown * 48px - 2px);
            VerticalLayout {
                spacing: Space.s_2;
                for c in root.address_book: Rectangle {
                    height: (root.filter == "" || root.contact_matches_search(c.name, c.address, c.tag, root.filter)) ? 46px : 0px;
                    clip: true;
                    border-radius: Radii.sm;
                    background: bta.has-hover ? Palette.hover_strong : transparent;
                    if root.filter == "" || root.contact_matches_search(c.name, c.address, c.tag, root.filter): HorizontalLayout {
                        padding-left: Space.s_8; padding-right: Space.s_8; spacing: Space.s_10;
                        VerticalLayout { alignment: center; Avatar { initial: c.initial; tint: c.color; size: 28px; } }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center; spacing: Space.s_2;
                            Text { text: c.name; color: Palette.text_primary; font-family: Fonts.ui; font-weight: Fonts.semibold; font-size: Fonts.body; overflow: elide; }
                            Text { text: c.short; color: Palette.text_tertiary; font-family: Fonts.ui; font-size: Fonts.micro; overflow: elide; }
                        }
                        if c.tag != "": VerticalLayout { alignment: center; Chip { label: c.tag; } }
                    }
                    bta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(c.address); }
                    }
                }
            }
        }
    }
}

export component ActivityTokenMenu inherits MenuSurface {
    in property <[AssetRow]> all_assets;
    in property <int> selected_token;
    callback pick(int);
    VerticalLayout {
        padding: Space.s_8;
        spacing: Space.s_2;
        Rectangle {
            height: 38px;
            border-radius: Radii.sm;
            border-width: root.selected_token == -2 ? 1px : 0px;
            border-color: Palette.selected_border;
            background: root.selected_token == -2 ? Palette.accent_quiet : (all_ta.has-hover ? Palette.hover_strong : transparent);
            HorizontalLayout {
                padding-left: Space.s_8; padding-right: Space.s_10; spacing: Space.s_8;
                VerticalLayout { alignment: center; Icon { source: @image-url("../../assets/icons/coins.svg"); tint: Palette.text_tertiary; width: 15px; height: 15px; } }
                VerticalLayout { alignment: center; Text { text: "All tokens"; color: Palette.text_primary; font-family: Fonts.ui; font-weight: Fonts.semibold; font-size: Fonts.body; } }
                Rectangle { }
                if root.selected_token == -2: VerticalLayout { alignment: center; Icon { source: @image-url("../../assets/icons/check.svg"); tint: Palette.accent_text; width: 13px; height: 13px; } }
            }
            all_ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(-2); } }
        }
        for a in root.all_assets: Rectangle {
            height: 38px;
            border-radius: Radii.sm;
            border-width: root.selected_token == a.control_id ? 1px : 0px;
            border-color: Palette.selected_border;
            background: root.selected_token == a.control_id ? Palette.accent_quiet : (tok_ta.has-hover ? Palette.hover_strong : transparent);
            HorizontalLayout {
                padding-left: Space.s_8; padding-right: Space.s_10; spacing: Space.s_8;
                VerticalLayout { alignment: center; Avatar { initial: a.initial; tint: a.color; size: 22px; } }
                VerticalLayout { alignment: center; Text { text: a.symbol; color: Palette.text_primary; font-family: Fonts.ui; font-weight: Fonts.semibold; font-size: Fonts.body; } }
                Rectangle { }
                if root.selected_token == a.control_id: VerticalLayout { alignment: center; Icon { source: @image-url("../../assets/icons/check.svg"); tint: Palette.accent_text; width: 13px; height: 13px; } }
            }
            tok_ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(a.control_id); } }
        }
    }
}

export component ActivityPartyMenu inherits MenuSurface {
    in property <[ContactRow]> address_book;
    in property <string> selected_party;
    in-out property <string> search;
    in property <length> list_h;
    in property <int> shown;
    in property <int> extra;
    pure callback contact_matches_search(string, string, string, string) -> bool;
    pure callback matching_contact_count(string) -> int;
    callback pick(string);
    VerticalLayout {
        padding: Space.s_8;
        spacing: Space.s_4;
        Field {
            height_: 32px;
            text <=> root.search;
            placeholder: "Name or address";
            font_size: Fonts.small;
            pad_left: 10px;
        }
        Rectangle {
            height: 40px;
            border-radius: Radii.sm;
            background: root.selected_party == "" ? Palette.accent_quiet : (any_ta.has-hover ? Palette.hover_row : transparent);
            HorizontalLayout {
                padding-left: Space.s_8; padding-right: Space.s_10; spacing: Space.s_8;
                VerticalLayout { alignment: center; Icon { source: @image-url("../../assets/icons/ban.svg"); tint: Palette.text_tertiary; width: 18px; height: 18px; } }
                VerticalLayout { alignment: center; Text { text: "Anyone"; color: Palette.text_primary; font-family: Fonts.ui; font-weight: Fonts.semibold; font-size: Fonts.body; } }
                Rectangle { }
                if root.selected_party == "": VerticalLayout { alignment: center; Icon { source: @image-url("../../assets/icons/check.svg"); tint: Palette.accent_text; width: 13px; height: 13px; } }
            }
            any_ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(""); } }
        }
        Rectangle { height: 1px; background: Palette.border_subtle; }
        ScrollView {
            height: root.list_h;
            scrolled => { UserActivity.ping(); }
            viewport-height: (root.shown + root.extra) * 40px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                spacing: Space.s_0;
                alignment: start;
                for c in root.address_book: row := Rectangle {
                    property <bool> vis: root.search == "" || root.contact_matches_search(c.name, c.address, c.tag, root.search);
                    height: row.vis ? 40px : 0px;
                    clip: true;
                    border-radius: Radii.sm;
                    background: (row.vis && cta.has-hover) ? Palette.hover_row : transparent;
                    if row.vis: HorizontalLayout {
                        padding-left: Space.s_8; padding-right: Space.s_10; spacing: Space.s_8;
                        VerticalLayout { alignment: center; Avatar { initial: c.initial; tint: c.color; size: 24px; } }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Space.s_2;
                            Text { text: c.name; color: Palette.text_primary; font-family: Fonts.ui; font-weight: Fonts.semibold; font-size: Fonts.body; overflow: elide; }
                            Text { text: c.short; color: Palette.text_tertiary; font-family: Fonts.ui; font-size: Fonts.micro; overflow: elide; }
                        }
                        if c.tag != "": VerticalLayout {
                            alignment: center;
                            Chip { label: c.tag; }
                        }
                    }
                    cta := TouchArea { mouse-cursor: pointer; enabled: row.vis; clicked => { root.pick(c.address); } }
                }
                if root.search != "" && root.matching_contact_count(root.search) == 0: Rectangle {
                    height: 40px;
                    border-radius: Radii.sm;
                    background: use_ta.has-hover ? Palette.hover_row : transparent;
                    HorizontalLayout {
                        padding-left: Space.s_8; padding-right: Space.s_10; spacing: Space.s_8;
                        VerticalLayout { alignment: center; Rectangle { width: 24px; height: 24px; border-radius: Radii.sm; background: Palette.accent_quiet; Icon { source: @image-url("../../assets/icons/plus.svg"); tint: Palette.accent_text; width: 13px; height: 13px; } } }
                        VerticalLayout { alignment: center; Text { text: "Use \"" + root.search + "\" as address"; color: Palette.text_secondary; font-family: Fonts.ui; font-size: Fonts.small; overflow: elide; } }
                    }
                    use_ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(root.search); } }
                }
            }
        }
    }
}
