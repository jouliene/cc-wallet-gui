export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> read_only: false;
    in property <TextHorizontalAlignment> alignment: TextHorizontalAlignment.left;
    in property <InputType> input_type: InputType.text;
    in property <bool> is_secret: false;
    property <bool> holds_secret: root.is_secret || root.input_type == InputType.password;
    in property <length> height_: Theme.field_h;
    in property <length> font_size: Fonts.body;
    in property <string> font_family: Fonts.ui;
    in property <int> font_weight: Fonts.medium;
    in property <length> pad_left: 12px;
    in property <length> pad_right: 12px;
    in property <color> field_bg: Palette.surface_sunken;
    in property <color> border_normal: Palette.border_strong;
    in property <bool> editing_border: false;
    in property <bool> intercept_paste: false;
    in property <bool> group_digits: false;
    in property <string> money_int;
    in property <float> text_opacity: 1.0;
    in property <bool> multiline: false;
    property <EditFmt> pending_fmt;
    out property <bool> has_focus <=> input.has-focus;
    in property <bool> show_focus_border: true;
    callback edited(string);
    callback accepted();
    callback paste_requested();
    callback escape_pressed();
    in property <bool> handles_escape: false;

    property <bool> lit: (input.has-focus || root.editing_border) && root.show_focus_border;
    property <length> caret_margin: 6px;
    property <length> line_height: root.font_size * 1.6;
    property <length> inner_w: max(1px, root.width - root.pad_left - root.pad_right);
    property <length> inner_h: max(1px, root.height - (root.multiline ? 2 * root.pad_left : 0px));
    property <length> caret_x: 0px;
    property <length> caret_y: 0px;

    height: root.height_;
    border-radius: Radii.md;
    border-width: 1px;
    border-color: !root.enabled
        ? Palette.border_subtle
        : (root.lit ? Palette.focus_border : root.border_normal);
    background: root.enabled ? root.field_bg : Palette.surface_disabled;
    clip: true;
    forward-focus: input;

    if root.enabled && root.lit: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: parent.border-radius - 1px;
        border-width: 1px;
        border-color: Palette.focus_glow;
    }

    public function paste() { input.paste(); }
    public function set_text(t: string) { input.text = t; }
    public function paste_replace() {
        if (root.holds_secret) {
            input.text = "";
        } else {
            input.select-all();
        }
        input.paste();
    }
    public function copy_all() {
        if (!root.holds_secret) {
            input.select-all();
            input.copy();
            input.clear-selection();
        }
    }

    input := TextInput {
        text <=> root.text;
        enabled: root.enabled;
        read-only: root.read_only;
        input-type: root.input_type;
        x: root.pad_left + (root.multiline
            ? 0px
            : min(0px, max(root.inner_w - self.width - self.text-cursor-width, root.caret_x)));
        y: root.multiline
            ? root.pad_left + min(0px, max(root.inner_h - self.height, root.caret_y))
            : 0px;
        width: root.multiline
            ? root.inner_w
            : max(root.inner_w - self.text-cursor-width, self.preferred-width);
        height: root.multiline ? max(root.inner_h, self.preferred-height) : parent.height;
        page-height: root.inner_h;
        cursor-position-changed(cpos) => {
            if (root.multiline) {
                if (cpos.y + root.caret_y < 0px) {
                    root.caret_y = - cpos.y;
                } else if (cpos.y + root.caret_y > root.inner_h - root.line_height) {
                    root.caret_y = root.inner_h - cpos.y - root.line_height;
                }
            } else {
                if (cpos.x + root.caret_x < root.caret_margin) {
                    root.caret_x = root.caret_margin - cpos.x;
                } else if (cpos.x + root.caret_x > root.inner_w - root.caret_margin) {
                    root.caret_x = root.inner_w - cpos.x - root.caret_margin;
                }
            }
        }
        color: Palette.text_primary;
        opacity: root.text_opacity;
        font-family: root.font_family;
        font-size: root.font_size;
        font-weight: root.font_weight;
        horizontal-alignment: root.alignment;
        vertical-alignment: root.multiline ? top : center;
        single-line: !root.multiline;
        wrap: root.multiline ? word-wrap : no-wrap;
        selection-background-color: Palette.selection_bg;
        selection-foreground-color: Palette.text_on_fill;
        edited => {
            UserActivity.ping();
            if (root.group_digits) {
                root.pending_fmt = AmountFormat.regroup(self.text, self.cursor-position-byte-offset);
                self.text = root.pending_fmt.text;
                self.set-selection-offsets(root.pending_fmt.cursor, root.pending_fmt.cursor);
            }
            root.edited(self.text);
        }
        accepted => { root.accepted(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.handles_escape) {
                    root.escape_pressed();
                    return accept;
                }
                return reject;
            }
            if (root.holds_secret
                && (event.modifiers.control || event.modifiers.meta)
                && (event.text == "c" || event.text == "C"
                    || event.text == "x" || event.text == "X")) {
                return accept;
            }
            if (root.holds_secret
                && ((event.modifiers.control || event.modifiers.meta)
                    && (event.text == "a" || event.text == "A"))) {
                return accept;
            }
            if (root.holds_secret && event.modifiers.shift
                && (event.text == Key.LeftArrow || event.text == Key.RightArrow
                    || event.text == Key.UpArrow || event.text == Key.DownArrow
                    || event.text == Key.Home || event.text == Key.End)) {
                return accept;
            }
            return reject;
        }
    }

    if root.money_int != "": Text {
        text: root.money_int;
        x: root.pad_left;
        height: 100%;
        color: Palette.text_primary;
        font-family: root.font_family;
        font-size: root.font_size;
        font-weight: Fonts.semibold;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        accessible-role: none;
    }

    Text {
        visible: root.text == "";
        text: root.placeholder;
        x: root.pad_left;
        y: root.multiline ? root.pad_left : 0px;
        width: max(1px, parent.width - root.pad_left - root.pad_right);
        height: root.multiline ? parent.height - 2 * root.pad_left : parent.height;
        color: Palette.text_placeholder;
        font-family: Fonts.ui;
        font-weight: Fonts.regular;
        font-size: root.font_size;
        horizontal-alignment: root.alignment;
        vertical-alignment: root.multiline ? top : center;
        wrap: root.multiline ? word-wrap : no-wrap;
        accessible-role: none;
    }

    if !root.holds_secret: ContextMenuArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        Menu {
            MenuItem {
                title: "Copy";
                enabled: root.text != "";
                activated => { input.copy(); }
            }
            MenuItem {
                title: "Paste";
                enabled: root.enabled && !root.read_only;
                activated => {
                    if (root.intercept_paste) {
                        root.paste_requested();
                    } else {
                        input.paste();
                    }
                }
            }
            MenuItem {
                title: "Select All";
                enabled: root.text != "";
                activated => { input.select-all(); }
            }
        }
    }

    if root.holds_secret: TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
}
