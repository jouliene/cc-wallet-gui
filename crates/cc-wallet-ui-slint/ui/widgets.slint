    }
}

export component StatusBar inherits Rectangle {
    in property <string> label;
    in property <color> tint: Palette.text_quiet;
    in property <color> fill: Palette.surface_sunken;
    in property <color> frame: Palette.border_subtle;
    in property <image> icon;
    in property <bool> show_icon: false;
    height: 36px;
